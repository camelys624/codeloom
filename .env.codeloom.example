# Codeloom modification of Multica v0.5.0: internal, source-built deployment.
# Prefer generating .env.codeloom rather than copying this incomplete example:
# node scripts/codeloom-init.mjs --origin http://192.168.1.20:3100 --email teammate@example.com
# Requires Docker Compose >= 2.24.4 (!override); run from the repository root:
# docker compose --project-name codeloom --env-file .env.codeloom -f docker-compose.selfhost.yml -f docker-compose.selfhost.build.yml -f docker-compose.codeloom.yml up -d --build
# This reuses the upstream services with isolated codeloom volumes/local images.
# Never use this env with the upstream Compose file alone.

# REQUIRED: browser-facing http(s) origin, no path/query/credentials/fragment.
CODELOOM_PUBLIC_ORIGIN=http://192.168.1.20:3100
# Namespaced to avoid inheriting the original Codeloom's PUBLIC_ORIGIN.
# REQUIRED: hostname from CODELOOM_PUBLIC_ORIGIN; direct backend URLs use HTTP + BACKEND_PORT.
PUBLIC_HOST=192.168.1.20
# REQUIRED: an IPv4 address on this machine's trusted LAN interface, never 0.0.0.0.
# A domain in CODELOOM_PUBLIC_ORIGIN requires --bind-address when using the generator.
BIND_ADDRESS=192.168.1.20
# REQUIRED: frontend published port; normally the port from CODELOOM_PUBLIC_ORIGIN.
# HTTPS requires your own LAN TLS reverse proxy; both containers serve plain HTTP.
# Behind that proxy choose an unused internal frontend port and forward to it.
FRONTEND_PORT=3100
# Direct backend/daemon published port (default 8180); must differ from FRONTEND_PORT.
BACKEND_PORT=8180

# REQUIRED: explicit comma-separated team emails. Blank values refuse Compose startup.
# General signup and domain allowlists are disabled; listed users can still join.
# Initial workspace creation remains enabled. Existing users retain login access.
ALLOWED_EMAILS=
POSTGRES_DB=multica
POSTGRES_USER=multica
# REQUIRED: independent secure secrets. The generator supplies fresh random values.
# JWT/PG: 32 random bytes encoded as hex; PG must remain URL-safe for DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
# REQUIRED: exactly 32 random bytes, base64 encoded; keep for encrypted VCS credentials.
MULTICA_VCS_SECRET_KEY=

# Optional internal SMTP; upstream emits random login codes in backend logs if absent.
# Protect log access. No fixed verification code is configured; APP_ENV is production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=starttls
SMTP_TLS_INSECURE=false

# Compose forces telemetry off and default locale zh-Hans; explicit user locale wins.
# No managed cloud URL; browser API/WS stay same-origin via the web runtime proxy.
# PostgreSQL has no published port. Restrict both web/API ports to trusted LAN users:
# Docker published ports can bypass host firewalls. Do not expose this stack publicly.
# WARNING: same-user daemons have that user's full filesystem/command permissions.
# Only enroll trusted machines/users; daemon execution is not sandboxed by this stack.
# Keep the private env at mode 0600, out of git, and backed up with persistent data.
