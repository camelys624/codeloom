DATABASE_URL=postgresql://agent_workspace:agent_workspace_local@127.0.0.1:5432/agent_workspace
NODE_ENV=development
HOST=0.0.0.0
PORT=5181
# For LAN access, replace 192.168.31.234 with this host's current LAN IP.
PUBLIC_ORIGIN=http://192.168.31.234:5173
SERVE_STATIC=false
DATA_DIR=.data
# Required outside development; use a random value of at least 32 bytes.
SESSION_SECRET=replace-with-a-random-secret
# Optional; if set, /metrics requires Authorization: Bearer <METRICS_TOKEN>.
METRICS_TOKEN=
# Optional ACP gate model ID from the bridge's advertised capabilities.
# SPIKE_MODEL=opus
